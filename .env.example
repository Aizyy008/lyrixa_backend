# Database Configuration
# Development (local database)
DATABASE_URL_DEV=postgresql://lyrixa_user:your_secure_password@localhost:5432/lyrixa_dev

# Production (Render PostgreSQL)
DATABASE_URL_PROD=postgresql://lyrixa_user:password@your_render_host:5432/lyrixa_prod

# Environment
NODE_ENV=development

# Optional: Custom API Keys (if needed)
# API_KEY=your_api_key_here

# Notes:
# - In development: uses DATABASE_URL_DEV
# - In production: uses DATABASE_URL_PROD
# - Server automatically switches based on NODE_ENV
# - Replace 'your_secure_password' with actual secure password
# - Replace 'your_render_host' with actual Render database host
